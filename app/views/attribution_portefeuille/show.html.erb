<% content_for :title, "Attribution portefeuille - Pilotage NRR" %>
<% eur = ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) } %>
<% bi = @vue == "bi" %>

<h1 class="section-title">Attribution portefeuille</h1>

<%= render "attribution_portefeuille/view_switch", annee: @annee, current: @vue %>

<% if bi %>
  <div class="bi-sync-bar">
    <span>
      <% if @last_synced_at %>
        Dernière synchronisation BI : <strong><%= l(@last_synced_at.in_time_zone("Europe/Paris"), format: "%d/%m/%Y à %Hh%M") %></strong>
        · mise à jour automatique chaque jour à 11h et 17h.
      <% else %>
        <strong>Aucune donnée BI synchronisée pour l'instant.</strong>
      <% end %>
    </span>
    <%= button_to "Synchroniser maintenant", sync_bi_attribution_portefeuille_path, class: "button", form: { style: "display:inline;" },
          data: { turbo_submits_with: "Synchronisation…" } %>
  </div>
<% else %>
  <p class="section-sub">
    Campagne <%= @annee %> telle que saisie dans l'outil, conservée jusqu'à sa clôture dans l'Historique.
    Taille du portefeuille de chaque personne en nombre de comptes et en ARR, et capacité restante à attribuer.
    Plafond de comptes par personne : <strong><%= User::ACCOUNT_LIMITS[:kam] %> pour un KAM, <%= User::DEFAULT_ACCOUNT_LIMIT %> pour un AM, <%= User::ACCOUNT_LIMITS[:tl_am] %> pour un TL AM, <%= User::ACCOUNT_LIMITS[:tl_csm] %> pour un TL Customer Care, <%= User::ACCOUNT_LIMITS[:head_csm] %> pour un Head of CSM</strong>. Un compte est un client dont au moins un produit n'est pas churné
    (les clients entièrement churnés sont exclus) ; l'ARR est celui des produits encore actifs.
  </p>
<% end %>

<% if bi && @last_synced_at.nil? %>
  <p class="notice" style="border-radius:var(--radius-sm);">Lancez une synchronisation pour charger les portefeuilles depuis la BI.</p>
<% else %>
  <%= render "repartition", eur: eur, bi: bi %>
  <%= render "entreprises", eur: eur, bi: bi %>
  <%= render "sans_am", eur: eur if bi %>
<% end %>
