<%# locals: rows, risque_assureurs (the card's own Assureur filter) — "Churn par risque": one block per risque (Mutuelle (santé) / Prévoyance), each with two plainly
    labelled bars on a shared scale — "Churn à date" (already lost) and "Churn projeté" (lost so far + the
    risk-weighted ARR of the contracts still active). The bordeaux tick marks the churn limit. %>
<% eur = ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) } %>
<% pct = ->(v) { "#{number_with_precision(v, precision: 1)} %" } %>
<% limit = PortfolioSummary::CHURN_LIMIT_PCT %>
<% scale_max = [rows.map { |r| [r[:value], r[:projected]].max }.max.to_f, limit].max * 1.15 %>
<% width = ->(v) { [v.to_f / scale_max * 100, 100].min.round(1) } %>
<div class="chart-wrap span-2 risque-card">
  <div class="risque-card-header">
    <h2>Churn par risque</h2>
    <%# This card's own filter: it narrows these bars only, and keeps the page's Équipe/AM selection. %>
    <%= form_with url: autres_statistiques_path, method: :get, class: "risque-filter" do %>
      <%= preserved_query_fields("risque_assureurs", "risque_assureurs_open") %>
      <%= render "shared/checklist_filter", param_name: "risque_assureurs", options: ProduitDeal::ASSUREURS, selected: risque_assureurs, legend: "Assureur" %>
    <% end %>
  </div>
  <div class="risque-card-legend">
    <div class="risque-legend">
      <span><i style="background:var(--burgundy)"></i>Churn à date</span>
      <span><i style="background:var(--primary)"></i>Churn projeté</span>
      <span><i class="limit"></i>Limite <%= pct.call(limit) %></span>
    </div>
  </div>
  <div class="risque-grid">
    <% rows.each do |r| %>
      <div class="risque-block">
        <div class="risque-head">
          <strong><%= r[:label] %></strong>
          <span>ARR total <%= eur.call(r[:total]) %> · <%= r[:count] %> produit<%= "s" if r[:count] > 1 %> churné<%= "s" if r[:count] > 1 %> sur <%= r[:produits_count] %></span>
        </div>
        <% [["Churn à date", r[:value], r[:churned], "var(--burgundy)"],
            ["Churn projeté", r[:projected], r[:projected_amount], "var(--primary)"]].each do |label, rate, amount, color| %>
          <div class="risque-line">
            <span class="risque-label"><%= label %></span>
            <div class="bar-track">
              <div class="bar-fill" style="width:<%= width.call(rate) %>%;background:<%= color %>;"></div>
              <div class="risque-limit" style="left:<%= width.call(limit) %>%;"></div>
            </div>
            <span class="risque-value" style="color:<%= rate > limit ? "var(--red)" : "var(--text)" %>">
              <strong><%= pct.call(rate) %></strong> <small><%= eur.call(amount) %></small>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
