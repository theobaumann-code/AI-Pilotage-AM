<% content_for :title, "Autres statistiques — Pilotage NRR" %>
<% content_for :page_class, "statistics-page" %>

<h1 class="section-title">Autres statistiques</h1>
<p class="section-sub">Statistiques complémentaires, séparées de Vue globale.</p>

<div class="chart-wrap">
  <h2>Renouvellements : nouveau contrat vs augmentation</h2>
  <div class="toolbar" style="margin-bottom:14px;">
    <%= form_with url: autres_statistiques_path, method: :get do %>
      <label>AM :
        <%= select_tag :renewal_am_id, options_from_collection_for_select(User.active.order(:name), :id, :name, @renewal_am_id),
              include_blank: "Tous les AM", onchange: "this.form.requestSubmit()" %>
      </label>
      <label>Produit :
        <%= select_tag :renewal_produit, options_for_select(ProduitDeal::PRODUITS, @renewal_produit),
              include_blank: "Tous les produits", onchange: "this.form.requestSubmit()" %>
      </label>
    <% end %>
  </div>
  <%= donut_chart(@renewal_donut) %>
</div>

<div class="chart-wrap">
  <h2>Répartition de l'ARR par produit</h2>
  <p class="section-sub" style="margin-top:-8px;">Portefeuille actif actuel (hors churn, hors churn subi).</p>
  <%= donut_chart(@arr_by_produit, value_format: ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) },
        total_label: ->(t) { "Total : #{number_to_currency(t, unit: "€", format: "%n %u", precision: 0)}" }) %>
</div>

<div class="chart-wrap">
  <h2>Répartition de l'ARR par assureur</h2>
  <p class="section-sub" style="margin-top:-8px;">Portefeuille actif actuel (hors churn, hors churn subi).</p>
  <%= donut_chart(@arr_by_assureur, value_format: ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) },
        total_label: ->(t) { "Total : #{number_to_currency(t, unit: "€", format: "%n %u", precision: 0)}" }) %>
</div>

<div class="section-card">
  <div class="table-toolbar">
    <h2>Concentration du portefeuille</h2>
  </div>
  <p class="section-sub" style="margin-top:-8px;">
    Les 10 plus gros clients représentent <strong><%= number_with_precision(@concentration[:top10_pct], precision: 1) %>%</strong>
    de l'ARR actif total (<%= number_to_currency(@concentration[:total], unit: "€", format: "%n %u", precision: 0) %>).
  </p>
  <div class="table-scroll">
    <table class="deals-table">
      <thead>
        <tr>
          <th class="numeric">#</th>
          <th>Client</th>
          <th>AM</th>
          <th class="numeric">ARR</th>
          <th class="numeric">% du portefeuille</th>
          <th class="numeric">% cumulé</th>
        </tr>
      </thead>
      <tbody>
        <% if @concentration[:rows].empty? %>
          <tr><td colspan="6" class="empty-state">Aucune donnée.</td></tr>
        <% else %>
          <% @concentration[:rows].each_with_index do |r, i| %>
            <tr>
              <td class="numeric"><%= i + 1 %></td>
              <td><strong><%= r[:name] %></strong></td>
              <td><%= r[:am] %></td>
              <td class="numeric"><%= number_to_currency(r[:arr], unit: "€", format: "%n %u", precision: 0) %></td>
              <td class="numeric"><%= number_with_precision(r[:pct], precision: 1) %>%</td>
              <td class="numeric"><%= number_with_precision(r[:cumulative_pct], precision: 1) %>%</td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="chart-wrap">
  <h2>Distribution de la taille des contrats</h2>
  <p class="section-sub" style="margin-top:-8px;">Portefeuille actif actuel, par tranche d'ARR.</p>
  <%= bar_rows(@contract_size_buckets, value_format: ->(r) { "#{r[:count]} (#{number_to_currency(r[:value], unit: "€", format: "%n %u", precision: 0)})" }) %>
</div>

<div class="chart-wrap">
  <h2>Évolution du NRR global</h2>
  <p class="section-sub" style="margin-top:-8px;">Tous produits et AM confondus, année après année (archives + année en cours).</p>
  <%= line_chart(@nrr_by_year[:years], [{ label: "NRR", points: @nrr_by_year[:points] }], 100) %>
</div>

<div class="section-card">
  <div class="table-toolbar">
    <h2>Évolution du churn subi vs churn classique</h2>
  </div>
  <p class="section-sub" style="margin-top:-8px;">Le churn subi (liquidation/rachat) n'est pas compté dans le NRR — voir s'il prend une part croissante reste un signal utile.</p>
  <div class="table-scroll">
    <table class="deals-table">
      <thead>
        <tr>
          <th class="numeric">Année</th>
          <th class="numeric">Churn classique</th>
          <th class="numeric">Churn subi</th>
          <th class="numeric">Total</th>
        </tr>
      </thead>
      <tbody>
        <% if @churn_by_year.empty? %>
          <tr><td colspan="4" class="empty-state">Aucune donnée.</td></tr>
        <% else %>
          <% @churn_by_year.each do |r| %>
            <tr>
              <td class="numeric"><strong><%= r[:year] %></strong></td>
              <td class="numeric" style="color:var(--red)"><%= number_to_currency(r[:classique], unit: "€", format: "%n %u", precision: 0) %></td>
              <td class="numeric"><%= number_to_currency(r[:subi], unit: "€", format: "%n %u", precision: 0) %></td>
              <td class="numeric"><%= number_to_currency(r[:classique] + r[:subi], unit: "€", format: "%n %u", precision: 0) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="chart-wrap">
  <h2>Taux de churn par assureur</h2>
  <p class="section-sub" style="margin-top:-8px;">ARR churné ÷ ARR total, par assureur (hors churn subi).</p>
  <%= bar_rows(@churn_rate_by_assureur, value_format: ->(r) { "#{number_with_precision(r[:value], precision: 1)}%" }) %>
</div>

<div class="chart-wrap">
  <h2>Taux de churn par collège</h2>
  <p class="section-sub" style="margin-top:-8px;">ARR churné ÷ ARR total, par collège (hors churn subi).</p>
  <%= bar_rows(@churn_rate_by_college, value_format: ->(r) { "#{number_with_precision(r[:value], precision: 1)}%" }) %>
</div>

<div class="chart-wrap">
  <h2>Raisons de churn par produit</h2>
  <p class="section-sub" style="margin-top:-8px;">ARR churné par raison (nombre de produits entre parenthèses), d'après les raisons saisies dans « Produits churnés » de Vue globale (hors churn subi).</p>
  <div style="display:flex;gap:48px;flex-wrap:wrap;">
    <% @churn_reasons_by_produit.each do |produit, slices| %>
      <div>
        <h3 style="font-size:14px;margin:0 0 10px;"><%= produit %></h3>
        <%= donut_chart(slices, value_format: ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) },
              total_label: ->(t) { "Total : #{number_to_currency(t, unit: "€", format: "%n %u", precision: 0)}" }) %>
      </div>
    <% end %>
  </div>
</div>

<div class="chart-wrap">
  <h2>Entonnoir des upsells</h2>
  <p class="section-sub" style="margin-top:-8px;">Nombre d'upsells à chaque étape, part du total et montant ARR upsellé entre parenthèses.</p>
  <%= bar_rows(@upsell_funnel, value_format: ->(r) { "#{r[:value]} · #{number_with_precision(r[:pct], precision: 1)}% (#{number_to_currency(r[:amount], unit: "€", format: "%n %u", precision: 0)})" }) %>
</div>

<div class="chart-wrap">
  <h2>Entonnoir des produits à renouveler</h2>
  <p class="section-sub" style="margin-top:-8px;">Nombre de produits à chaque étape de renouvellement, part du total et ARR entre parenthèses.</p>
  <%= bar_rows(@renewal_funnel, value_format: ->(r) { "#{r[:value]} · #{number_with_precision(r[:pct], precision: 1)}% (#{number_to_currency(r[:amount], unit: "€", format: "%n %u", precision: 0)})" }) %>
</div>

<div class="chart-wrap">
  <h2>Portefeuille accompagné vs non accompagné</h2>
  <%= donut_chart(@accompagnement_split, value_format: ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) },
        total_label: ->(t) { "Total : #{number_to_currency(t, unit: "€", format: "%n %u", precision: 0)}" }) %>
</div>
