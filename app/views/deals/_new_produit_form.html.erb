<div class="modal-box" style="margin:12px 0 0;">
  <%= form_with url: deals_path(type: "produit", redirect_user_id: viewed_user.id), method: :post do %>
    <div class="modal-body">
      <div class="modal-row">
        <label>Client
          <select name="company_id">
            <option value="">— Nouveau client —</option>
            <% companies.each do |c| %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% end %>
          </select>
        </label>
        <label>Nom du nouveau client
          <input type="text" name="new_company_name" placeholder="Si nouveau client">
        </label>
        <% if ams %>
          <label>AM (si nouveau client)
            <select name="new_company_user_id">
              <% ams.each do |am| %>
                <option value="<%= am.id %>" <%= "selected" if am == current_user %>><%= am.name %></option>
              <% end %>
            </select>
          </label>
        <% end %>
      </div>
      <div class="modal-row">
        <label>Produit
          <select name="deal[produit]">
            <% ProduitDeal::PRODUITS.each { |p| %><option value="<%= p %>"><%= p %></option><% } %>
          </select>
        </label>
        <label>Collège
          <select name="deal[college]">
            <% ProduitDeal::COLLEGES.each { |c| %><option value="<%= c %>"><%= c %></option><% } %>
          </select>
        </label>
        <label>Assureur
          <select name="deal[assureur]">
            <% ProduitDeal::ASSUREURS.each { |a| %><option value="<%= a %>"><%= a %></option><% } %>
          </select>
        </label>
      </div>
      <div class="modal-row">
        <label>ID externe
          <input type="text" name="deal[identifiant]">
        </label>
        <label>ARR (€)
          <input type="number" step="0.01" name="deal[arr]" value="0">
        </label>
        <label>Taux négocié (%)
          <input type="number" step="0.01" name="deal[taux]" value="0">
        </label>
        <label>Statut de renouvellement
          <select name="deal[statut_renouvellement]">
            <% ProduitDeal::STATUTS_RENOUVELLEMENT.each { |s| %><option value="<%= s %>"><%= s %></option><% } %>
          </select>
        </label>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="ghost-burgundy" onclick="this.closest('details').removeAttribute('open')">Annuler</button>
      <button type="submit" class="primary">Ajouter le produit</button>
    </div>
  <% end %>
</div>
