<% content_for :auth_page, "true" %>
<% content_for :title, "Connexion · Pilotage AM SideCare" %>
<div class="auth-page">
  <section class="auth-panel" aria-labelledby="welcome-title">
    <div class="auth-brand">
      <%= image_tag "sidecare.svg", alt: "SideCare", width: 128, height: 23 %>
      <span>Pilotage AM</span>
    </div>
    <div class="auth-content">
      <span class="auth-eyebrow"><i aria-hidden="true"></i> Espace interne</span>
      <h1 id="welcome-title">La relation grandit,<br><em>le portefeuille aussi.</em></h1>
      <p>Une vue claire pour suivre vos clients, anticiper les renouvellements et faire grandir chaque portefeuille.</p>
    </div>
    <div class="auth-signals" aria-hidden="true">
      <span>Suivre</span><span>Anticiper</span><span>Développer</span>
    </div>
  </section>

  <section class="auth-sso-side" aria-labelledby="signin-title">
    <div class="auth-sso-card">
      <span class="auth-mark" aria-hidden="true">AM</span>
      <span class="auth-label">Pilotage des portefeuilles</span>
      <h2 id="signin-title">Bienvenue.</h2>
      <p class="auth-subtitle">Retrouvez votre espace SideCare.</p>
      <% if notice %><p class="auth-message" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="auth-message auth-message-alert" role="alert"><%= alert %></p><% end %>
      <% if Devise.omniauth_configs.key?(:google_oauth2) %>
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post, class: "auth-google-button", data: { turbo: false } do %>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.39-.18-2.05H12v3.88h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.89-1.74 2.98-4.3 2.98-7.36z"/>
            <path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.62-2.41l-3.24-2.51c-.9.6-2.06.96-3.38.96-2.61 0-4.82-1.76-5.61-4.12H3.04v2.59A10 10 0 0 0 12 22z"/>
            <path fill="#FBBC05" d="M6.39 13.92a6 6 0 0 1 0-3.84V7.49H3.04a10 10 0 0 0 0 9.02l3.35-2.59z"/>
            <path fill="#EA4335" d="M12 5.96c1.47 0 2.79.51 3.82 1.51l2.87-2.87A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.96 5.49l3.35 2.59C7.18 7.72 9.39 5.96 12 5.96z"/>
          </svg>
          Continuer avec Google
        <% end %>
      <% else %>
        <p class="auth-message auth-message-alert" role="alert">La connexion Google n’est pas encore configurée. Contactez un administrateur.</p>
      <% end %>
      <p class="auth-note">Accès réservé aux comptes AM autorisés de l’organisation <strong>@sidecare.com</strong>.</p>
    </div>
  </section>
</div>
