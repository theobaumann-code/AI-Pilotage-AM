<section class="login-card">
  <h1>Connexion au pilotage NRR</h1>
  <% if Devise.omniauth_configs.key?(:google_oauth2) %>
    <p>Utilisez votre compte Google professionnel SideCare.</p>
    <%= button_to "Se connecter avec Google", user_google_oauth2_omniauth_authorize_path,
        method: :post, class: "button primary", data: { turbo: false } %>
  <% else %>
    <p role="alert">La connexion Google n’est pas encore configurée. Contactez un administrateur.</p>
  <% end %>
  <p>Votre compte doit avoir été créé et activé par un administrateur.</p>
</section>
