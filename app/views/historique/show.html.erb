<% content_for :title, "Historique — Pilotage NRR" %>

<p class="section-title">Historique</p>
<p class="section-sub">Taux de renouvellement par contrat client, année après année.</p>

<div class="toolbar">
  <span class="badge">Année en cours : <%= @current_year %></span>

  <% if current_user.admin? %>
    <details>
      <summary class="button">Modifier l'année en cours</summary>
      <div class="modal-box" style="margin:12px 0 0;">
        <%= form_with url: app_setting_path, method: :patch do %>
          <div class="modal-body">
            <label>Nouveau numéro d'année
              <%= number_field_tag :annee_en_cours, @current_year %>
            </label>
          </div>
          <div class="modal-footer">
            <span></span>
            <button type="submit" class="button primary">Enregistrer</button>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <details>
    <summary class="button ghost-burgundy">🗑 Corbeille<% if @trash_batches.any? %><span class="badge warn" style="margin-left:6px;"><%= @trash_batches.size %></span><% end %></summary>
    <div class="modal-box" style="margin:12px 0 0;max-width:520px;">
      <% if current_user.admin? && @archivable_years.any? %>
        <p style="margin:0 0 8px;font-size:12px;color:var(--text-muted);">Déplacer une année archivée vers la corbeille (réversible) :</p>
        <% @archivable_years.each do |y| %>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:6px 0;">
            <span>Année <%= y %></span>
            <%= button_to "Mettre à la corbeille", trash_batches_path(year: y), method: :post, class: "button ghost-danger",
                  form: { data: { turbo_confirm: "Déplacer l'année #{y} vers la corbeille ? Rien n'est perdu : restaurable à tout moment." } } %>
          </div>
        <% end %>
        <hr style="margin:12px 0;border-color:var(--border);">
      <% end %>
      <% if @trash_batches.empty? %>
        <div class="empty-state">Corbeille vide.</div>
      <% else %>
        <% @trash_batches.each do |batch| %>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);">
            <div>
              <strong>Année <%= batch.year %></strong>
              <div style="font-size:12px;color:var(--text-muted);">supprimée le <%= batch.deleted_at.strftime("%d/%m/%Y %H:%M") %></div>
            </div>
            <% if current_user.admin? %>
              <div style="display:flex;gap:8px;flex-shrink:0;">
                <%= button_to "Restaurer", restore_trash_batch_path(batch), method: :patch, class: "button" %>
                <%= button_to "Supprimer définitivement", trash_batch_path(batch), method: :delete, class: "button ghost-danger",
                      form: { data: { turbo_confirm: "Supprimer définitivement l'année #{batch.year} ? Cette action est irréversible." } } %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </details>

  <div class="spacer"></div>

  <% if current_user.admin? %>
    <%= button_to "Clôturer l'année en cours et passer à la suivante →", year_closure_path, method: :post, class: "button primary",
          form: { data: { turbo_confirm: "Clôturer l'année #{@current_year} ? Les produits renouvelés seront reconduits (nouvelle base ARR, taux remis à zéro), les contrats churnés et les upsells seront retirés du portefeuille actif. Tout reste consultable dans l'historique." } } %>
  <% end %>
</div>

<%= form_with url: historique_path, method: :get do %>
  <div class="toolbar" style="flex-wrap:wrap;align-items:flex-start;gap:18px;">
    <label>AM :
      <%= render "checklist", param_name: "ams", options: @available_ams, selected: @ams, legend: "Tous les AM" %>
    </label>
    <label>Entreprise :
      <%= render "checklist", param_name: "noms", options: @available_noms, selected: @noms, legend: "Toutes les entreprises" %>
    </label>
    <label>Produit :
      <%= select_tag :produit, options_for_select(ProduitDeal::PRODUITS, @produit), include_blank: "Tous les produits" %>
    </label>
    <label>Statut de renouvellement :
      <%= render "checklist", param_name: "statuts", options: ProduitDeal::STATUTS_RENOUVELLEMENT, selected: @statuts, legend: "Tous les statuts" %>
    </label>
    <label>Assureur :
      <%= render "checklist", param_name: "assureurs", options: ProduitDeal::ASSUREURS, selected: @assureurs, legend: "Tous les assureurs" %>
    </label>
  </div>

  <div class="year-filter" style="margin:14px 0;">
    <% @available_years.each do |y| %>
      <label class="year-chip <%= "active" if @years.include?(y) %>" style="cursor:pointer;">
        <input type="checkbox" name="years[]" value="<%= y %>" <%= "checked" if @years.include?(y) %> style="position:absolute;opacity:0;width:0;height:0;">
        <%= y %> <span style="opacity:.6;font-size:10px;"><%= y == @current_year ? "●" : "🔒" %></span>
      </label>
    <% end %>
  </div>

  <button type="submit" class="button primary">Filtrer</button>
<% end %>

<div class="section-card" style="margin-top:20px;">
  <div class="table-toolbar">
    <h3>Historique par contrat</h3>
  </div>
  <div class="table-scroll">
    <table class="am-table">
      <thead>
        <tr>
          <th>Nom du client</th>
          <th>AM responsable</th>
          <th>Produit</th>
          <th>Année</th>
          <th>ARR</th>
          <th>Taux de renouvellement</th>
          <th>Statut de renouvellement</th>
          <th>ARR renouvelé</th>
        </tr>
      </thead>
      <tbody>
        <% if @rows.empty? %>
          <tr><td colspan="8" class="empty-state"><%= @years.empty? ? "Sélectionnez au moins une année." : "Aucune donnée pour l'instant." %></td></tr>
        <% else %>
          <% @rows.each do |r| %>
            <% editable = !r.is_live && current_user.admin? %>
            <tr class="<%= "churn-yes" if r.churned? %>">
              <td><%= r.nom %></td>
              <td><%= r.am || "—" %></td>
              <td><%= r.produit %></td>
              <td><%= r.annee %></td>
              <td>
                <% if editable %>
                  <%= form_with scope: :archive_entry, url: archive_entry_path(r.id), method: :patch do |f| %>
                    <%= f.number_field :arr, value: r.arr, min: 0, step: 100, style: "width:110px;", onchange: "this.form.requestSubmit()" %>
                  <% end %>
                <% else %>
                  <%= number_to_currency(r.arr, unit: "€", format: "%n %u", precision: 0) %>
                <% end %>
              </td>
              <td>
                <% if editable %>
                  <%= form_with scope: :archive_entry, url: archive_entry_path(r.id), method: :patch do |f| %>
                    <%= f.number_field :taux, value: r.taux, step: 0.5, style: "width:80px;", disabled: r.churned?, onchange: "this.form.requestSubmit()" %>
                  <% end %>
                <% else %>
                  <% if r.churned? %>
                    —
                  <% else %>
                    <span style="color:<%= r.taux.to_f >= 0 ? "var(--green)" : "var(--red)" %>"><%= r.taux.to_f >= 0 ? "+" : "" %><%= r.taux.to_f %>%</span>
                  <% end %>
                <% end %>
              </td>
              <td>
                <% if editable %>
                  <%= form_with scope: :archive_entry, url: archive_entry_path(r.id), method: :patch do |f| %>
                    <%= f.select :statut_renouvellement, ProduitDeal::STATUTS_RENOUVELLEMENT, { selected: r.statut_renouvellement }, onchange: "this.form.requestSubmit()" %>
                  <% end %>
                <% else %>
                  <%= r.statut_renouvellement %>
                <% end %>
              </td>
              <td><%= r.arr_renouvele.nil? ? "—" : number_to_currency(r.arr_renouvele, unit: "€", format: "%n %u", precision: 0) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="chart-wrap">
  <h3>Historique du taux de renouvellement</h3>
  <%= line_chart(@years.sort, @taux_chart, 0) %>
  <div class="chart-legend">Respecte les filtres ci-dessus. Avec une entreprise sélectionnée : la courbe de cette entreprise. Sans entreprise sélectionnée : une courbe par produit, moyenne pondérée par l'ARR sur toutes les entreprises.</div>
</div>

<div class="chart-wrap">
  <h3>Historique du NRR par cohorte annuelle</h3>
  <%= line_chart(@years.sort, @nrr_chart, 100) %>
  <div class="chart-legend">Même principe que le graphique ci-dessus, mais pour le NRR de chaque année (ARR renouvelé rapporté à l'ARR initial de cette année) : la ligne noire horizontale représente 100%.</div>
</div>

<div class="chart-wrap">
  <h3>Augmentation moyenne par assureur</h3>
  <% if @assureur_chart.none? { |e| e[:count] > 0 } %>
    <div class="empty-state">Aucune donnée pour ce filtre.</div>
  <% else %>
    <% max_abs = [1.0, *@assureur_chart.map { |e| e[:avg].nil? ? 0 : e[:avg].abs }].max %>
    <% @assureur_chart.each do |e| %>
      <% pct = e[:avg].nil? ? 0 : [e[:avg].abs / max_abs * 100, 100].min %>
      <% color = e[:avg].nil? ? "var(--track-bg)" : (e[:avg] >= 0 ? "var(--green)" : "var(--red)") %>
      <div style="display:grid;grid-template-columns:160px 1fr 110px;align-items:center;gap:10px;font-size:13px;margin-bottom:8px;">
        <span><%= e[:assureur] %></span>
        <div class="progress-track"><div class="progress-fill" style="width:<%= pct %>%;background:<%= color %>;"></div></div>
        <span style="text-align:right;color:var(--text-muted);"><%= e[:avg].nil? ? "—" : "#{e[:avg] >= 0 ? "+" : ""}#{number_with_precision(e[:avg], precision: 1)}%" %> (<%= e[:count] %>)</span>
      </div>
    <% end %>
  <% end %>
  <div class="chart-legend">Respecte les filtres ci-dessus. Moyenne du taux de renouvellement négocié (%) sur les produits de l'assureur, tous statuts confondus.</div>
</div>

<div class="chart-wrap">
  <h3>Répartition des produits renouvelés par statut de renouvellement</h3>
  <%= donut_chart(@statut_donut) %>
  <div class="chart-legend">Respecte les filtres ci-dessus.</div>
</div>
