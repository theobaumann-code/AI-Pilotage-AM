<% content_for :title, "Import CSV — Pilotage NRR" %>

<p class="section-title">Import en masse (CSV)</p>
<p class="section-sub">Importez plusieurs contrats en une fois, ou mettez à jour des contrats existants.</p>

<div class="section-card">
  <%= form_with url: preview_import_path, method: :post, multipart: true, data: { turbo: false } do %>
    <div class="modal-row">
      <label>Type de deal à importer
        <select name="deal_type">
          <option value="produit" <%= "selected" if @deal_type != "upsell" %>>Produits à renouveler</option>
          <option value="upsell" <%= "selected" if @deal_type == "upsell" %>>Upsells</option>
        </select>
      </label>
    </div>
    <div class="modal-row">
      <label>Fichier CSV
        <input type="file" name="csv_file" accept=".csv,text/csv">
      </label>
    </div>
    <div class="modal-row">
      <%= link_to "⬇ Télécharger le modèle (Produits)", import_template_path(type: "produit"), class: "button" %>
      <%= link_to "⬇ Télécharger le modèle (Upsells)", import_template_path(type: "upsell"), class: "button" %>
    </div>
    <div class="modal-row" style="width:100%;">
      <label style="width:100%;">Ou collez le contenu CSV
        <textarea name="csv_text" rows="8" style="width:100%;font-family:monospace;"><%= @csv_text if @csv_text.present? %></textarea>
      </label>
    </div>
    <button type="submit" class="button primary">Analyser</button>
  <% end %>

  <div class="hint-box" style="margin-top:20px;">
    <p style="margin:0 0 6px;">Colonnes reconnues pour un import <strong>Produit</strong> (insensibles à la casse/accents) :</p>
    <ul style="margin:0 0 10px;padding-left:18px;">
      <li><strong>Nom</strong></li>
      <li><strong>Produit</strong> — Mutuelle ou Prévoyance uniquement</li>
      <li><strong>Identifiant / SIREN</strong> — clé de correspondance, obligatoire</li>
      <li><strong>ARR</strong>, <strong>Taux de renouvellement négocié</strong> — nombres acceptés sous presque n'importe quelle forme : "10000", "10000,50", "10 000", "10.000,50", "10,000.50"… (séparateur de milliers espace/point/virgule, décimales avec virgule ou point, "€" ignoré)</li>
      <li><strong>Statut de renouvellement</strong> — En cours / Nouveau contrat / Augmenté / Augmentation particulière / Churné</li>
      <li><strong>Collège</strong> — <%= ProduitDeal::COLLEGES.join(" / ") %> ; facultatif, "<%= ProduitDeal::COLLEGES.first %>" par défaut si absent</li>
      <li><strong>Assureur</strong> — facultatif</li>
      <li><strong>AM</strong> — obligatoire, doit correspondre à un AM existant</li>
    </ul>
    <p style="margin:0 0 6px;">Pour un import <strong>Upsell</strong> : Nom, Produit, Nb salariés, % de chance, Statut, AM (aucun identifiant nécessaire).</p>
    <p style="margin:0 0 6px;">Les valeurs de Produit / Collège / Assureur / Statut tolèrent aussi le pluriel ("Cadres", "Non Cadres"…).</p>
    <p style="margin:0;">La colonne AM détermine l'AM de chaque ligne — un même fichier peut mélanger plusieurs portefeuilles. Si une entreprise apparaît avec des AM différents, tout le fichier est rejeté. Une ligne dont la clé existe déjà met à jour le deal existant (et réaffecte l'entreprise si l'AM diffère) ; sinon un nouveau deal est créé.</p>
  </div>
</div>

<% if @result %>
  <div class="section-card">
    <h3>Aperçu de l'import</h3>
    <p>
      <%= @result.to_create.size %> nouveau(x) deal(s), <%= @result.to_update.size %> mise(s) à jour<%
        %><% if @result.warnings.any? %>, <%= @result.warnings.size %> avertissement(s)<% end %><%
        %><% if @result.errors.any? %>, <%= @result.errors.size %> ligne(s) ignorée(s)<% end %>
    </p>

    <div class="table-scroll">
      <table class="deals-table">
        <thead>
          <tr>
            <th>Statut</th>
            <th>AM</th>
            <th>Entreprise</th>
            <th>Produit</th>
            <% if @result.deal_type == "upsell" %>
              <th>Nb salariés</th>
              <th>% de chance</th>
              <th>Statut signature</th>
            <% else %>
              <th>ARR</th>
              <th>Statut renouvellement</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @result.to_create.each do |c| %>
            <tr>
              <td><span class="badge ok">Nouveau</span></td>
              <td><%= c.am_name %></td>
              <td><%= c.company_name %></td>
              <td><%= c.attrs[:produit] %></td>
              <% if @result.deal_type == "upsell" %>
                <td><%= c.attrs[:nombre_salaries] %></td>
                <td><%= c.attrs[:probabilite_signature] %>%</td>
                <td><%= c.attrs[:statut_signature] %></td>
              <% else %>
                <td><%= number_to_currency(c.attrs[:arr], unit: "€", format: "%n %u", precision: 0) %></td>
                <td><%= c.attrs[:statut_renouvellement] %></td>
              <% end %>
            </tr>
          <% end %>
          <% @result.to_update.each do |u| %>
            <tr>
              <td><span class="badge warn">MàJ</span></td>
              <td><%= u.am_name %><% if u.existing_am_name != u.am_name %> <span class="badge warn">réaffecté</span><% end %></td>
              <td><%= u.company_name %></td>
              <td colspan="<%= @result.deal_type == "upsell" ? 4 : 3 %>" style="color:var(--text-muted)"><%= u.attrs.size %> champ(s) modifié(s)</td>
            </tr>
          <% end %>
          <% if @result.to_create.empty? && @result.to_update.empty? %>
            <tr><td colspan="7" class="empty-state">Rien à importer.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% @result.warnings.each do |w| %>
      <p style="color:var(--amber);font-size:13px;">⚠ <%= w %></p>
    <% end %>
    <% @result.errors.each do |e| %>
      <p style="color:var(--red);font-size:13px;"><%= e %></p>
    <% end %>

    <% if @result.valid_for_apply? %>
      <%= form_with url: import_path, method: :post, data: { turbo: false } do %>
        <%= hidden_field_tag :deal_type, @deal_type %>
        <%= hidden_field_tag :csv_text, @csv_text %>
        <button type="submit" class="button primary">Confirmer l'import</button>
      <% end %>
    <% end %>
  </div>
<% end %>
