<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Pilotage NRR — SideCare" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pilotage NRR">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Titles use Fraunces (serif), body/UI text uses Satoshi — the SideCare design system's two-font rule
        (see design-system repo, "Typography"). Neither was actually being loaded before (the CSS referenced
        them by name but always silently fell back to the OS font). %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">

    <%# Icon system (design system's TableActions/LabelActions conventions expect Font Awesome — solid for
        decorative/primary icons, regular for secondary/link icons). Nothing was loaded before, so every
        action icon in the app was a plain emoji glyph instead. %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? "signed-in" : "signed-out" %>">
    <% if user_signed_in? %>
      <div class="app-shell">
        <%= render "shared/app_sidebar" %>
        <div class="app-content">
          <main id="main-content" class="<%= content_for(:page_class) %>">
            <div id="flash"><%= render "shared/flash", notice: notice, alert: alert %></div>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="auth-shell" id="main-content"><%= yield %></main>
    <% end %>
  </body>
</html>
