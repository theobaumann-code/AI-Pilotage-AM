          <span style="color:var(--text-muted);">· Pilotage NRR</span>
        </div>
        <div class="header-actions">
          <div class="admin-zone">
            <span class="badge <%= current_user.admin? ? 'ok' : (current_user.kam? ? 'kam' : 'warn') %>"><%= current_user.role_label %> · <%= current_user.name %></span>
          </div>
          <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "button" %>
        </div>
      </header>

      <nav class="tabs">
        <%= link_to "Mon portefeuille", portfolio_path, class: current_page?(portfolio_path) ? "active" : nil %>
        <%= link_to "Résultats AM", pilotage_path, class: current_page?(pilotage_path) ? "active" : nil %>
        <% if current_user.kam_or_admin? %>
          <%= link_to "Résultats KAM", resultats_kam_path, class: current_page?(resultats_kam_path) ? "active" : nil %>
        <% end %>
        <%= link_to "Historique", historique_path, class: current_page?(historique_path) ? "active" : nil %>
      </nav>
    <% end %>

    <main>
      <% if notice %><p class="notice"><%= notice %></p><% end %>
      <% if alert %><p class="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
