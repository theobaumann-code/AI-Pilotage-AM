<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pilotage NRR — SideCare" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pilotage NRR">
