<%# locals: impacts, companies — the "Autres impacts" table at the bottom of Mon portefeuille. %>
<div class="section-card" id="other-impacts">
  <div class="table-toolbar">
    <h2>Autres impacts</h2>
  </div>
  <p class="section-sub" style="margin-top:-8px;">
    Impacts ARR singuliers saisis à la main, hors renouvellement, churn et upsell. Un montant « Validé » est ajouté uniquement à l'ARR final et au NRR actuels ;
    un montant « En cours » uniquement à l'ARR final et au NRR projetés.
  </p>
  <div class="table-scroll">
    <table class="deals-table">
      <thead>
        <tr>
          <th>Client</th>
          <th>Produit</th>
          <th class="numeric">Montant impacté (€)</th>
          <th>Commentaire</th>
          <th>Statut</th>
          <th class="col-action"></th>
        </tr>
      </thead>
      <tbody>
        <% if impacts.empty? %>
          <tr><td colspan="6" class="empty-state">Aucun autre impact pour le moment.</td></tr>
        <% else %>
          <%= render partial: "other_impacts/row", collection: impacts, as: :impact, locals: { companies: companies } %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
