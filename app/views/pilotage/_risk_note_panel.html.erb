<%# locals: company — the rescue-effort log for one at-risk company, expandable inline in its own <td>.
    Full-page redirects (see RiskNotesController): occasional note-taking, not a row edited over and over.
    return_to carries the current filtered/paginated URL through the round trip explicitly — relying on
    redirect_back's Referer header turned out not to reliably survive a real submit, dropping the admin
    back onto an unfiltered page. Structure (modal-box/modal-body/modal-footer, Annuler + primary submit)
    mirrors every other inline panel on this page (the non-accompagné entries "Modifier", "+ Nouveau
    produit"), instead of the ad hoc layout this started with. %>
<details>
  <summary class="button" style="font-size:12px;padding:4px 10px;"><i class="fa-regular fa-comment"></i> <%= company.risk_notes.size %></summary>
  <div class="modal-box" style="margin:8px 0 0;max-width:380px;">
    <% if company.risk_notes.any? %>
      <div class="modal-body" style="padding-bottom:0;">
        <% company.risk_notes.each do |note| %>
          <div style="border-bottom:1px solid var(--border);padding-bottom:8px;">
            <div class="subtitle" style="font-size:12px;color:var(--text-muted);display:flex;justify-content:space-between;align-items:center;gap:8px;">
              <span><%= note.user.name %> — <%= note.created_at.strftime("%d/%m/%Y %H:%M") %></span>
              <% if current_user.privileged? || note.user == current_user %>
                <%= button_to content_tag(:i, "", class: "fa-solid fa-trash-can"), risk_note_path(note, return_to: request.fullpath), method: :delete, class: "icon-btn danger",
                      title: "Supprimer ce commentaire",
                      style: "width:22px;height:22px;font-size:11px;flex-shrink:0;",
                      form: { data: { turbo_confirm: "Supprimer ce commentaire ?" }, style: "display:inline-block;" } %>
              <% end %>
            </div>
            <p style="margin:4px 0 0;white-space:pre-wrap;"><%= note.content %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="modal-body" style="padding-bottom:0;">
        <p class="empty-state" style="margin:0;">Aucun commentaire.</p>
      </div>
    <% end %>
    <% if current_user.read_only? %>
      <div class="modal-footer">
        <button type="button" class="button ghost-burgundy" onclick="this.closest('details').removeAttribute('open')">Fermer</button>
      </div>
    <% else %>
      <%= form_with url: risk_notes_path, method: :post do %>
        <%= hidden_field_tag :company_id, company.id %>
        <%= hidden_field_tag :return_to, request.fullpath %>
        <div class="modal-body">
          <textarea name="risk_note[content]" rows="2" placeholder="Nouvelle démarche…" required style="width:100%;"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="button ghost-burgundy" onclick="this.closest('details').removeAttribute('open')">Annuler</button>
          <button type="submit" class="button primary">Ajouter</button>
        </div>
      <% end %>
    <% end %>
  </div>
</details>
