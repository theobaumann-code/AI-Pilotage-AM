<% content_for :title, "Vue globale — Pilotage NRR" %>

<p class="section-title">Vue globale</p>
<p class="section-sub">Vue consolidée pour suivre l'atteinte de l'objectif NRR (<%= PortfolioSummary::NRR_TARGET %>%) sur chaque portefeuille.</p>

<div class="toolbar" style="margin-bottom:14px;">
  <%= form_with url: pilotage_path, method: :get do %>
    <%= preserved_query_fields("summary_ams", "summary_ams_open", "summary_roles", "summary_roles_open") %>
    <%= render "shared/checklist_filter", param_name: "summary_roles", options: @available_roles, selected: @summary_roles, legend: "Équipe" %>
    <%= render "shared/checklist_filter", param_name: "summary_ams", options: @available_summary_ams, selected: @summary_ams, legend: "AM" %>
  <% end %>
</div>
<%= render "shared/summary_cards", summary: @global_summary, dom_id: "global-summary-cards" %>

<%# Small contracts nobody actively manages (no AM, no individual renewal tracking) — SideCare still wants
    their combined weight visible on Vue globale, but mixing them into the NRR/churn cards above would be
    meaningless (there's no per-contract renewal data to compute those from). Kept as its own isolated card
    with three manually-set figures (ARR, churn, taux de renouvellement), editable by admins only. %>
<div class="metric-card" style="max-width:520px;margin-bottom:24px;">
  <div class="metric-card-title">Portefeuille non accompagné</div>
  <div class="metric-pair">
    <div class="metric-col">
      <div class="metric-col-label">ARR</div>
      <div class="metric-col-value"><%= number_to_currency(@app_setting.arr_non_accompagne, unit: "€", format: "%n %u", precision: 0) %></div>
    </div>
    <div class="metric-col">
      <div class="metric-col-label">Churn</div>
      <div class="metric-col-value"><%= number_to_currency(@app_setting.churn_non_accompagne, unit: "€", format: "%n %u", precision: 0) %></div>
    </div>
    <div class="metric-col">
      <div class="metric-col-label">Taux de renouvellement</div>
      <div class="metric-col-value"><%= number_with_precision(@app_setting.taux_renouvellement_non_accompagne, precision: 1) %>%</div>
    </div>
  </div>
  <% if current_user.admin? %>
    <details>
      <summary class="button" style="margin-top:10px;">Modifier</summary>
      <div class="modal-box" style="margin:12px 0 0;">
        <%= form_with url: app_setting_path, method: :patch do %>
          <div class="modal-body">
            <div class="modal-row">
              <label>ARR non accompagné (€)
                <%= number_field_tag :arr_non_accompagne, @app_setting.arr_non_accompagne, step: "0.01", min: 0 %>
              </label>
              <label>Churn non accompagné (€)
                <%= number_field_tag :churn_non_accompagne, @app_setting.churn_non_accompagne, step: "0.01", min: 0 %>
              </label>
              <label>Taux de renouvellement non accompagné (%)
                <%= number_field_tag :taux_renouvellement_non_accompagne, @app_setting.taux_renouvellement_non_accompagne, step: "0.1" %>
              </label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="button ghost-burgundy" onclick="this.closest('details').removeAttribute('open')">Annuler</button>
            <button type="submit" class="button primary">Enregistrer</button>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>

<div class="section-card">
  <div class="table-toolbar">
    <h3>Entreprises à risque</h3>
  </div>
  <p class="section-sub" style="margin-top:-8px;">Toute entreprise avec au moins un produit à renouveler portant un % de risque de churn.</p>
  <%= turbo_frame_tag "rque-table-frame" do %>
    <div class="table-toolbar">
      <div class="table-toolbar-controls">
        <%= form_with url: request.path, method: :get do %>
          <%= preserved_query_fields("risque_q", "risque_ams", "risque_ams_open", "risque_roles", "risque_roles_open",
                "risque_produits", "risque_produits_open", "risque_statuts", "risque_statuts_open", "rque_page") %>
          <%= live_search_field :risque_q, @risque_q %>
          <%= render "shared/checklist_filter", param_name: "risque_roles", options: @available_roles, selected: @risque_roles, legend: "Équipe" %>
          <%= render "shared/checklist_filter", param_name: "risque_ams", options: @available_risque_ams, selected: @risque_ams, legend: "AM" %>
          <%= render "shared/checklist_filter", param_name: "risque_produits", options: ProduitDeal::PRODUITS, selected: @risque_produits, legend: "Produit" %>
          <%= render "shared/checklist_filter", param_name: "risque_statuts", options: ProduitDeal::STATUTS_RENOUVELLEMENT - ProduitDeal::CHURNED_STATUSES, selected: @risque_statuts, legend: "Statut" %>
        <% end %>
        <%= link_to "Exporter CSV", export_risque_pilotage_path(risque_q: @risque_q, risque_ams: @risque_ams,
              risque_roles: @risque_roles, risque_produits: @risque_produits, risque_statuts: @risque_statuts), class: "button", data: { turbo: false } %>
      </div>
    </div>
    <div class="table-scroll">
      <table class="deals-table renewal-table">
        <thead>
          <tr>
            <%= sortable_th(@rque_pager, :nom, "Nom du client", col_class: "col-nom") %>
            <%= sortable_th(@rque_pager, :am, "AM") %>
            <%= sortable_th(@rque_pager, :count, "Nb produits à risque") %>
            <%= sortable_th(@rque_pager, :arr_at_risk, "ARR à risque (€)") %>
            <%= sortable_th(@rque_pager, :max_risque, "% risque max") %>
          </tr>
        </thead>
        <tbody>
          <% if @rque_pager.records.empty? %>
            <tr><td colspan="5" class="empty-state">Aucune entreprise à risque pour ce filtre.</td></tr>
          <% else %>
            <% @rque_pager.records.each do |r| %>
              <tr id="<%= dom_id(r[:company], :risque) %>">
                <td><strong><%= r[:company].name %></strong></td>
                <td><%= r[:am].name %></td>
                <td><%= r[:count] %></td>
                <td style="color:var(--red)"><%= number_to_currency(r[:arr_at_risk], unit: "€", format: "%n %u", precision: 0) %></td>
                <td><%= r[:max_risque] %>%</td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination_controls(@rque_pager) %>
    <%= page_size_select(@rque_pager) %>
  <% end %>
</div>

<div class="section-card">
  <div class="table-toolbar">
    <h3>Produits à renouveler (tous AM)</h3>
  </div>
  <div class="summary-cards">
    <div class="card"><div class="label">Nb produits</div><div class="value"><%= @global_produits.size %></div></div>
    <div class="card"><div class="label">ARR total</div><div class="value"><%= number_to_currency(@global_produits.sum { |d| d.arr.to_f }, unit: "€", format: "%n %u", precision: 0) %></div></div>
    <div class="card"><div class="label">Taux moyen pondéré par l'ARR</div><div class="value"><%= @produit_taux_avg.nil? ? "—" : "#{@produit_taux_avg >= 0 ? "+" : ""}#{number_with_precision(@produit_taux_avg, precision: 1)}%" %></div></div>
    <div class="card"><div class="label">ARR final</div><div class="value"><%= number_to_currency(@global_produits.sum { |d| d.final_arr.to_f }, unit: "€", format: "%n %u", precision: 0) %></div></div>
  </div>
  <%= turbo_frame_tag "gprod-table-frame" do %>
    <div class="table-toolbar">
      <div class="table-toolbar-controls">
        <%= form_with url: request.path, method: :get do %>
          <%= preserved_query_fields("produit_q", "produit_ams", "produit_ams_open", "produit_roles", "produit_roles_open",
                "produit_produits", "produit_produits_open", "produit_statuts", "produit_statuts_open", "gprod_page") %>
          <%= live_search_field :produit_q, @produit_q %>
          <%= render "shared/checklist_filter", param_name: "produit_roles", options: @available_roles, selected: @produit_roles, legend: "Équipe" %>
          <%= render "shared/checklist_filter", param_name: "produit_ams", options: @available_produit_ams, selected: @produit_ams, legend: "AM" %>
          <%= render "shared/checklist_filter", param_name: "produit_produits", options: ProduitDeal::PRODUITS, selected: @produit_produits, legend: "Produit" %>
          <%= render "shared/checklist_filter", param_name: "produit_statuts", options: ProduitDeal::STATUTS_RENOUVELLEMENT, selected: @produit_statuts, legend: "Statut" %>
        <% end %>
        <%= link_to "Exporter CSV", export_produits_pilotage_path(produit_q: @produit_q, produit_ams: @produit_ams,
              produit_roles: @produit_roles, produit_produits: @produit_produits, produit_statuts: @produit_statuts), class: "button", data: { turbo: false } %>
      </div>
    </div>
    <div class="table-scroll">
      <table class="deals-table renewal-table">
        <thead>
          <tr>
            <%= sortable_th(@gprod_pager, :nom, "Nom du client", col_class: "col-nom") %>
            <%= sortable_th(@gprod_pager, :am, "AM") %>
            <%= sortable_th(@gprod_pager, :produit, "Produit", col_class: "col-produit") %>
            <%= sortable_th(@gprod_pager, :college, "Collège", col_class: "col-college") %>
            <%= sortable_th(@gprod_pager, :assureur, "Assureur", col_class: "col-assureur") %>
            <% if current_user.admin? %>
              <%= sortable_th(@gprod_pager, :identifiant, "ID externe", col_class: "col-identifiant") %>
            <% end %>
            <%= sortable_th(@gprod_pager, :arr, "ARR (€)", col_class: "col-arr") %>
            <%= sortable_th(@gprod_pager, :taux, "Taux négocié (%)", col_class: "col-taux") %>
            <%= sortable_th(@gprod_pager, :statut_renouvellement, "Statut de renouvellement", col_class: "col-churn") %>
            <%= sortable_th(@gprod_pager, :risque_churn, "% risque churn", col_class: "col-taux") %>
            <%= sortable_th(@gprod_pager, :final_arr, "ARR final", col_class: "col-final") %>
            <th class="col-action"></th>
          </tr>
        </thead>
        <tbody>
          <% if @gprod_pager.records.empty? %>
            <tr><td colspan="<%= current_user.admin? ? 12 : 11 %>" class="empty-state">Aucun produit configuré.</td></tr>
          <% else %>
            <%= render partial: "pilotage/global_produit_row", collection: @gprod_pager.records, as: :deal %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if current_user.privileged? %>
      <%= render "shared/reassign_am_panel", panel_id: "reassign-gprod-panel", form_id: "reassign-gprod-form",
            name_span_id: "reassign-gprod-name", ams: @active_ams %>
    <% end %>
    <%= pagination_controls(@gprod_pager) %>
    <%= page_size_select(@gprod_pager) %>
  <% end %>
</div>

<div class="section-card">
  <div class="table-toolbar">
    <h3>Upsells en cours (tous AM)</h3>
  </div>
  <div class="summary-cards">
    <div class="card"><div class="label">Nb upsells</div><div class="value"><%= @global_upsells.size %></div></div>
    <div class="card"><div class="label">Montant ARR upsellé total</div><div class="value"><%= number_to_currency(@upsell_montant_total, unit: "€", format: "%n %u", precision: 0) %></div></div>
    <div class="card"><div class="label">ARR projeté (selon % de chance)</div><div class="value"><%= number_to_currency(@upsell_projection_total, unit: "€", format: "%n %u", precision: 0) %></div></div>
    <div class="card"><div class="label">ARR upsellé à date (Signé)</div><div class="value" style="color:var(--green)"><%= number_to_currency(@upsell_signed_total, unit: "€", format: "%n %u", precision: 0) %></div></div>
  </div>
  <%= turbo_frame_tag "gups-table-frame" do %>
    <div class="table-toolbar">
      <div class="table-toolbar-controls">
        <%= form_with url: request.path, method: :get do %>
          <%= preserved_query_fields("upsell_q", "upsell_ams", "upsell_ams_open", "upsell_roles", "upsell_roles_open",
                "upsell_produits", "upsell_produits_open", "upsell_statuts", "upsell_statuts_open", "gups_page") %>
          <%= live_search_field :upsell_q, @upsell_q %>
          <%= render "shared/checklist_filter", param_name: "upsell_roles", options: @available_roles, selected: @upsell_roles, legend: "Équipe" %>
          <%= render "shared/checklist_filter", param_name: "upsell_ams", options: @available_upsell_ams, selected: @upsell_ams, legend: "AM" %>
          <%= render "shared/checklist_filter", param_name: "upsell_produits", options: UpsellDeal::PRODUITS, selected: @upsell_produits, legend: "Produit" %>
          <%= render "shared/checklist_filter", param_name: "upsell_statuts", options: UpsellDeal::STATUTS_SIGNATURE, selected: @upsell_statuts, legend: "Statut" %>
        <% end %>
        <%= link_to "Exporter CSV", export_upsells_pilotage_path(upsell_q: @upsell_q, upsell_ams: @upsell_ams,
              upsell_roles: @upsell_roles, upsell_produits: @upsell_produits, upsell_statuts: @upsell_statuts), class: "button", data: { turbo: false } %>
      </div>
    </div>
    <div class="table-scroll">
      <table class="deals-table upsell-table">
        <thead>
          <tr>
            <%= sortable_th(@ups_pager, :nom, "Nom du client", col_class: "col-nom") %>
            <%= sortable_th(@ups_pager, :am, "AM") %>
            <%= sortable_th(@ups_pager, :produit, "Produit", col_class: "col-produit") %>
            <%= sortable_th(@ups_pager, :nombre_salaries, "Nb salariés", col_class: "col-salaries") %>
            <%= sortable_th(@ups_pager, :upsell_amount, "Montant ARR upsellé (€)", col_class: "col-upsell-amount") %>
            <%= sortable_th(@ups_pager, :probabilite_signature, "% de chance", col_class: "col-proba") %>
            <%= sortable_th(@ups_pager, :projection, "Projection upsell (€)", col_class: "col-projection") %>
            <%= sortable_th(@ups_pager, :statut_signature, "Statut de signature", col_class: "col-signed") %>
            <th class="col-action"></th>
          </tr>
        </thead>
        <tbody>
          <% if @ups_pager.records.empty? %>
            <tr><td colspan="9" class="empty-state">Aucun upsell pour ce filtre.</td></tr>
          <% else %>
            <%= render partial: "global_upsell_row", collection: @ups_pager.records, as: :deal %>
          <% end %>
        </tbody>
        <% if @ups_pager.records.any? %>
          <tfoot>
            <tr class="table-footer-row">
              <td colspan="6">Total ARR projeté (résultats filtrés)</td>
              <td><%= number_to_currency(@upsell_projection_total, unit: "€", format: "%n %u", precision: 0) %></td>
              <td colspan="2"></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
    <% if current_user.privileged? %>
      <%= render "shared/reassign_am_panel", panel_id: "reassign-upsell-panel", form_id: "reassign-upsell-form",
            name_span_id: "reassign-upsell-name", ams: @active_ams %>
    <% end %>
    <%= pagination_controls(@ups_pager) %>
    <%= page_size_select(@ups_pager) %>
  <% end %>
</div>
