<% status_class = { applied: "ok", conflict: "ko", pending: "warn" } %>
<div class="section-card" id="comptes">
  <div class="table-toolbar">
    <h2>Comptes en projection</h2>
    <div class="table-toolbar-controls">
      <%= form_with url: projection_portefeuille_path(anchor: "comptes"), method: :get, data: { turbo_action: "replace" } do %>
        <%= preserved_query_fields("pc_q", "pc_arr_min", "pc_arr_max", "pc_concerned", "pc_concerned_open", "pc_movements", "pc_movements_open",
              "pc_owners", "pc_owners_open", "pc_bo", "pc_bo_open", "pc_modified", "pc_page") %>
        <%= live_search_field :pc_q, @pc_q, placeholder: "Rechercher un compte…" %>
        <%= render "shared/checklist_filter", param_name: "pc_concerned", options: @pc_concerned_options, selected: @pc_concerned, legend: "AM concerné" %>
        <%= render "shared/checklist_filter", param_name: "pc_movements", options: @pc_movement_options, selected: @pc_movements, legend: "Mouvement" %>
        <%= render "shared/range_filter", min_name: "pc_arr_min", max_name: "pc_arr_max", min: @pc_arr_min, max: @pc_arr_max, legend: "ARR (€)" %>
        <%= render "shared/checklist_filter", param_name: "pc_owners", options: @pc_owner_options, selected: @pc_owners, legend: "AM projeté" %>
        <%= render "shared/checklist_filter", param_name: "pc_bo", options: @pc_bo_options, selected: @pc_bo, legend: "AM dans le BO" %>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;">
          <%= check_box_tag :pc_modified, "1", @pc_modified, onchange: "this.form.requestSubmit()" %>
          Modifiés uniquement
        </label>
      <% end %>
    </div>
  </div>
  <p class="section-sub" style="margin-top:-8px;">
    <strong><%= @pc_total[:count] %></strong> compte<%= "s" if @pc_total[:count] > 1 %> · ARR <strong><%= eur.call(@pc_total[:arr]) %></strong>.
    Filtrez (par exemple « AM projeté » = un AM, ou « À réattribuer »), cochez des lignes ou tout le filtre, puis choisissez l'action.
    « AM concerné » retient les comptes qu'un AM a dans le BO ou reçoit dans la projection (gagnés comme perdus).
  </p>

  <%= form_with url: bulk_projection_portefeuille_path, method: :post do %>
    <%= render "bulk_bar", table: "comptes", targets: @targets, total: @pc_total[:count], extra: true %>
    <div class="table-scroll">
      <table class="deals-table">
        <thead>
          <tr>
            <th class="col-check"><input type="checkbox" aria-label="Tout cocher sur la page"
                  onchange="this.closest('form').querySelectorAll('input[name=&quot;keys[]&quot;]').forEach((c) => { c.checked = this.checked })"></th>
            <%= sortable_th(@pc_pager, :nom, "Compte", col_class: "col-nom") %>
            <%= sortable_th(@pc_pager, :bo, "AM dans le BO") %>
            <%= sortable_th(@pc_pager, :am, "AM projeté") %>
            <%= sortable_th(@pc_pager, :arr, "ARR (€)", col_class: "col-arr") %>
            <th>Risque couvert</th>
            <th>Mouvement</th>
          </tr>
        </thead>
        <tbody>
          <% if @pc_pager.records.empty? %>
            <tr><td colspan="7" class="empty-state">Aucun compte pour ce filtre.</td></tr>
          <% else %>
            <% @pc_pager.records.each do |e| %>
              <tr class="<%= "row-moved" if e.moved? %>">
                <td class="col-check"><%= check_box_tag "keys[]", e.account_key, false, id: nil, aria: { label: "Sélectionner #{e.account.name}" } %></td>
                <td>
                  <strong><%= e.account.name %></strong>
                  <br><small style="color:var(--text-muted);"><%= e.account.kind_label %><%= " · #{pluralize(e.account.user_pros_count, "entreprise")}" if e.account.set? %></small>
                </td>
                <td><%= @projection.label(e.bo_key) %></td>
                <td><strong><%= @projection.label(e.key) %></strong></td>
                <%= render "attribution_portefeuille/arr_cell", account: e.account, eur: eur %>
                <td><%= e.account.risque || "—" %></td>
                <td>
                  <% if e.moved? %>
                    <%= movement_label(e) %>
                    <% if e.move %><br><span class="badge <%= status_class[e.status] %>"><%= status_label(e) %></span><% end %>
                  <% else %>
                    <span style="color:var(--text-muted);">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= pagination_controls(@pc_pager) %>
  <%= page_size_select(@pc_pager) %>
</div>
