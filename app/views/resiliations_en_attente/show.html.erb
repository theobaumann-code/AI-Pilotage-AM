<% content_for :title, "Résiliations en attente - Pilotage NRR" %>
<% eur = ->(v) { number_to_currency(v, unit: "€", format: "%n %u", precision: 0) } %>
<% day = ->(d) { d ? l(d, format: "%d/%m/%Y") : "-" } %>

<h1 class="section-title">Résiliations en attente de signature</h1>

<div class="bi-sync-bar">
  <span>
    <% if @last_synced_at %>
      Dernière synchronisation BI : <strong><%= l(@last_synced_at.in_time_zone("Europe/Paris"), format: "%d/%m/%Y à %Hh%M") %></strong>
      · mise à jour automatique chaque jour à 11h et 17h.
    <% else %>
      <strong>Aucune donnée BI synchronisée pour l'instant.</strong>
    <% end %>
  </span>
  <%= button_to "Synchroniser maintenant", sync_resiliations_en_attente_path, class: "button", form: { style: "display:inline;" },
        data: { turbo_submits_with: "Synchronisation…" } %>
</div>

<div class="metrics-grid" style="grid-template-columns:repeat(3, minmax(0, 1fr));margin-bottom:20px;">
  <div class="metric-card metric-card--compact">
    <div class="metric-card-title">Résiliations en attente</div>
    <div class="metric-col-value"><%= @all_total[:count] %></div>
  </div>
  <div class="metric-card metric-card--compact">
    <div class="metric-card-title">Comptes concernés</div>
    <div class="metric-col-value"><%= @all_total[:accounts] %></div>
  </div>
  <div class="metric-card metric-card--compact">
    <div class="metric-card-title">ARR des contrats SideCare visés</div>
    <div class="metric-col-value"><%= eur.call(@all_total[:arr]) %></div>
  </div>
</div>

<div class="section-card" id="resiliations">
  <div class="table-toolbar">
    <h2>Résiliations</h2>
    <div class="table-toolbar-controls">
      <%= form_with url: resiliations_en_attente_path, method: :get, data: { turbo_action: "replace" } do %>
        <%= preserved_query_fields("q", "ams", "ams_open", "types", "types_open", "products", "products_open", "rs_page") %>
        <%= live_search_field :q, @q, placeholder: "Rechercher un client, un compte, un contrat…" %>
        <%= render "shared/checklist_filter", param_name: "ams", options: @am_options, selected: @ams, legend: "AM" %>
        <%= render "shared/checklist_filter", param_name: "types", options: @type_options, selected: @types, legend: "Type" %>
        <%= render "shared/checklist_filter", param_name: "products", options: @product_options, selected: @products, legend: "Produit" %>
      <% end %>
    </div>
  </div>
  <p class="section-sub" style="margin-top:-8px;">
    <strong><%= @total[:count] %></strong> résiliation<%= "s" if @total[:count] > 1 %> sur <strong><%= @total[:accounts] %></strong> compte<%= "s" if @total[:accounts] > 1 %>
    · ARR des contrats SideCare visés <strong><%= eur.call(@total[:arr]) %></strong>.
    Résiliations au statut « En attente de signature » dans le BO, sur un compte qui a un AM / KAM.
    « Contrat SideCare » : le client résilie un contrat SideCare (ARR = T1 2026 × 4, net) ; « Contrat externe » : il résilie son contrat chez un autre assureur.
  </p>
  <div class="table-scroll">
    <table class="deals-table">
      <thead>
        <tr>
          <%= sortable_th(@pager, :client, "Client") %>
          <%= sortable_th(@pager, :compte, "Compte") %>
          <%= sortable_th(@pager, :am, "AM") %>
          <th>Contrat</th>
          <%= sortable_th(@pager, :type, "Type") %>
          <%= sortable_th(@pager, :produit, "Produit") %>
          <%= sortable_th(@pager, :cree_le, "Créée le") %>
          <%= sortable_th(@pager, :date_effet, "Date d'effet") %>
          <%= sortable_th(@pager, :arr, "ARR du contrat (€)") %>
          <%= sortable_th(@pager, :arr_compte, "ARR du compte (€)") %>
        </tr>
      </thead>
      <tbody>
        <% if @pager.records.empty? %>
          <tr><td colspan="10" class="empty-state">Aucune résiliation en attente pour ce filtre.</td></tr>
        <% else %>
          <% @pager.records.each do |r| %>
            <% t = r[:termination]; a = r[:account] %>
            <tr>
              <td><strong><%= t.social_name.presence || "-" %></strong></td>
              <td><%= a.name %><% if a.set? %><br><small style="color:var(--text-muted);"><%= a.kind_label %></small><% end %></td>
              <td><%= a.am_name.presence || a.am_email %></td>
              <td><%= t.name.presence || "-" %></td>
              <td><span class="badge <%= t.terminable_type == "InternalContract" ? "ko" : "reader" %>"><%= t.type_label %></span></td>
              <td><%= t.product_label %></td>
              <td><%= day.call(t.created_on) %></td>
              <td><%= day.call(t.termination_date) %></td>
              <td class="numeric"><%= t.contract_arr ? eur.call(t.contract_arr) : "-" %></td>
              <td class="numeric"><%= eur.call(a.arr) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination_controls(@pager) %>
  <%= page_size_select(@pager) %>
</div>
